<Window x:Class="CrosshairOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Crosshair Settings" Height="800" Width="360"
        Closing="Window_Closing" Background="#17171C" Foreground="White">
    
    <Window.Resources>
        <SolidColorBrush x:Key="MainBg" Color="#17171C"/>
        <SolidColorBrush x:Key="ControlBg" Color="#252833"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4296FA"/>
        <SolidColorBrush x:Key="TextColor" Color="#FFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Crosshair Type / Shape"/>
            <ComboBox x:Name="ShapeCombo" SelectionChanged="Combo_SelectionChanged" Background="{StaticResource ControlBg}">
                <ComboBoxItem Content="Classic (Lines)"/>
                <ComboBoxItem Content="Dot Only"/>
                <ComboBoxItem Content="Circle (Holo)"/>
                <ComboBoxItem Content="Triangle (Reflex)"/>
                <ComboBoxItem Content="Custom Image (PNG)"/>
            </ComboBox>

            <Button x:Name="BrowseImageBtn" Content="Browse Custom Image..." Click="BrowseImage_Click" Visibility="Collapsed"/>
            
            <TextBlock x:Name="GapText" Text="Gap (Offset)"/>
            <Slider x:Name="GapSlider" Minimum="0" Maximum="50" ValueChanged="Slider_ValueChanged"/>
            
            <TextBlock x:Name="LengthText" Text="Length"/>
            <Slider x:Name="LengthSlider" Minimum="1" Maximum="100" ValueChanged="Slider_ValueChanged"/>
            
            <TextBlock x:Name="ThicknessText" Text="Thickness"/>
            <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20" ValueChanged="Slider_ValueChanged"/>

            <TextBlock x:Name="DotSizeText" Text="Center Dot Size"/>
            <Slider x:Name="DotSizeSlider" Minimum="1" Maximum="50" ValueChanged="Slider_ValueChanged"/>
            
            <TextBlock Text="Opacity"/>
            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" ValueChanged="Slider_ValueChanged"/>
            
            <CheckBox x:Name="CenterDotCheck" Content="Center Dot" Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="OutlineCheck" Content="Outline (Drop Shadow &amp; Stroke)" Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="TShapeCheck" Content="T-Shape (Hide top line)" Checked="Check_Changed" Unchecked="Check_Changed"/>
            <CheckBox x:Name="SmartHideCheck" Content="Smart Hide (Hide on hold)" Checked="Check_Changed" Unchecked="Check_Changed"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Hide Keybind: " VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="BindButton" Content="RightButton" Width="150" Height="25" Click="BindButton_Click" Background="{StaticResource ControlBg}"/>
            </StackPanel>

            <CheckBox x:Name="AutoHideCheck" Content="Auto-Hide when not in game" Checked="Check_Changed" Unchecked="Check_Changed"/>
            <TextBlock x:Name="TargetProcText" Text="Game Processes (comma separated)"/>
            <TextBox x:Name="TargetProcInput" TextChanged="TextInput_Changed"/>

            <TextBlock Text="Crosshair Color"/>
            <xctk:ColorPicker x:Name="ColorPickerControl" SelectedColorChanged="ColorPicker_SelectedColorChanged" Background="{StaticResource ControlBg}" Foreground="White" BorderThickness="0" Margin="0,5,0,15"/>

            <Border Background="{StaticResource ControlBg}" CornerRadius="8" Padding="10" Margin="0,10,0,10">
                <StackPanel>
                    <TextBlock Text="Share Profile" Margin="0,0,0,10" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ExportBtn" Content="Copy Code" Width="110" Click="ExportBtn_Click" Margin="0,0,10,0"/>
                        <Button x:Name="ImportBtn" Content="Paste Code" Width="110" Click="ImportBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
