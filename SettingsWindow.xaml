<Window x:Class="CrosshairOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Crosshair Overlay" Height="720" Width="380"
        Closing="Window_Closing" 
        Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Keep legacy keys for backward compat in code-behind -->
        <SolidColorBrush x:Key="MainBg" Color="{StaticResource BgDark}"/>
        <SolidColorBrush x:Key="ControlBg" Color="{StaticResource BgControl}"/>
        <SolidColorBrush x:Key="AccentColor" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="TextColor" Color="{StaticResource TextPrimary}"/>
    </Window.Resources>

    <Border CornerRadius="14" BorderThickness="1" ClipToBounds="True"
            Background="{StaticResource BgDarkBrush}">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2A2A44" Offset="0"/>
                <GradientStop Color="#14141E" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════ CUSTOM TITLE BAR ═══════ -->
            <Border Grid.Row="0" Background="#0A0A12" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{StaticResource Accent}" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="CROSSHAIR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="OVERLAY" FontSize="12" FontWeight="Light" Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button Content="─" Width="32" Height="28" FontSize="14" Click="MinimizeBtn_Click"
                                Background="Transparent" BorderThickness="0" Margin="0"/>
                        <Button Content="✕" Width="32" Height="28" FontSize="11" Click="CloseBtn_Click"
                                Background="Transparent" BorderThickness="0" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════ MAIN CONTENT ═══════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="16,8,16,20">

                    <!-- ═══════ SHAPE CARD ═══════ -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="SHAPE" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="ShapeCombo" SelectionChanged="Combo_SelectionChanged">
                                <ComboBoxItem Content="Classic (Lines)"/>
                                <ComboBoxItem Content="Dot Only"/>
                                <ComboBoxItem Content="Circle (Holo)"/>
                                <ComboBoxItem Content="Triangle (Reflex)"/>
                                <ComboBoxItem Content="Custom Image (PNG)"/>
                                <ComboBoxItem Content="Pixel Builder (16x16)"/>
                            </ComboBox>
                            <Button x:Name="BrowseImageBtn" Content="Browse Image..." Click="BrowseImage_Click" Visibility="Collapsed" Margin="0,6,0,0"/>

                            <TextBlock x:Name="GapText" Text="Gap"/>
                            <Slider x:Name="GapSlider" Minimum="0" Maximum="50" ValueChanged="Slider_ValueChanged"/>

                            <TextBlock x:Name="LengthText" Text="Length"/>
                            <Slider x:Name="LengthSlider" Minimum="1" Maximum="100" ValueChanged="Slider_ValueChanged"/>

                            <TextBlock x:Name="ThicknessText" Text="Thickness"/>
                            <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20" ValueChanged="Slider_ValueChanged"/>

                            <TextBlock x:Name="DotSizeText" Text="Dot Size"/>
                            <Slider x:Name="DotSizeSlider" Minimum="1" Maximum="50" ValueChanged="Slider_ValueChanged"/>

                            <TextBlock Text="Opacity"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" ValueChanged="Slider_ValueChanged"/>

                            <CheckBox x:Name="CenterDotCheck" Content="Center Dot" Checked="Check_Changed" Unchecked="Check_Changed"/>
                            <CheckBox x:Name="OutlineCheck" Content="Outline" Checked="Check_Changed" Unchecked="Check_Changed"/>
                            <CheckBox x:Name="TShapeCheck" Content="T-Shape" Checked="Check_Changed" Unchecked="Check_Changed"/>

                            <!-- Pixel Builder Grid -->
                            <Border x:Name="PixelGridBorder" Visibility="Collapsed" BorderBrush="{StaticResource BorderSoftBrush}" 
                                    BorderThickness="1" CornerRadius="8" Margin="0,10,0,4" HorizontalAlignment="Center" Padding="4">
                                <UniformGrid x:Name="PixelGrid" Columns="16" Rows="16" Width="224" Height="224" 
                                             MouseMove="PixelGrid_MouseMove" MouseLeftButtonDown="PixelGrid_MouseMove" MouseRightButtonDown="PixelGrid_MouseMove"/>
                            </Border>
                            <Button x:Name="ClearGridBtn" Content="Clear Grid" Visibility="Collapsed" Click="ClearGridBtn_Click" 
                                    HorizontalAlignment="Center" Width="100"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ COLOR CARD ═══════ -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="COLOR" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Crosshair"/>
                            <xctk:ColorPicker x:Name="ColorPickerControl" SelectedColorChanged="ColorPicker_SelectedColorChanged" 
                                              Background="{StaticResource BgControlBrush}" Foreground="White" 
                                              BorderThickness="0" Height="26" Margin="0,2,0,6"/>

                            <TextBlock Text="Outline"/>
                            <xctk:ColorPicker x:Name="OutlineColorPickerControl" SelectedColorChanged="ColorPicker_SelectedColorChanged" 
                                              Background="{StaticResource BgControlBrush}" Foreground="White" 
                                              BorderThickness="0" Height="26" Margin="0,2,0,6"/>

                            <CheckBox x:Name="RgbChromaCheck" Content="RGB Chroma (Rainbow)" Checked="Check_Changed" Unchecked="Check_Changed"/>
                            
                            <TextBlock x:Name="RgbSpeedText" Text="Chroma Speed"/>
                            <Slider x:Name="RgbSpeedSlider" Minimum="1" Maximum="20" ValueChanged="Slider_ValueChanged"/>

                            <CheckBox x:Name="InvertColorsCheck" Content="Invert Color (Contrast)" Checked="Check_Changed" Unchecked="Check_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ POSITION CARD ═══════ -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="POSITION" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Offset X"/>
                            <Slider x:Name="OffsetXSlider" Minimum="-500" Maximum="500" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock Text="Offset Y"/>
                            <Slider x:Name="OffsetYSlider" Minimum="-500" Maximum="500" ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ BEHAVIOR CARD ═══════ -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionTitle}"/>

                            <CheckBox x:Name="SmartHideCheck" Content="Smart Hide (ADS)" Checked="Check_Changed" Unchecked="Check_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Bind:" Width="60" VerticalAlignment="Center" Margin="0"/>
                                <Button x:Name="BindButton" Content="RightButton" Width="120" Click="BindButton_Click"/>
                            </StackPanel>

                            <CheckBox x:Name="AutoHideCheck" Content="Auto-Hide (Desktop)" Checked="Check_Changed" Unchecked="Check_Changed" Margin="0,10,0,2"/>
                            <TextBlock x:Name="TargetProcText" Text="Game Processes"/>
                            <TextBox x:Name="TargetProcInput" TextChanged="TextInput_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ HOTKEYS CARD ═══════ -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="HOTKEYS" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <TextBlock Text="Panic:" Width="80" VerticalAlignment="Center" Margin="0"/>
                                <Button x:Name="PanicBindButton" Content="F8" Width="120" Click="PanicBindButton_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Swap Profile:" Width="80" VerticalAlignment="Center" Margin="0"/>
                                <Button x:Name="SwapBindButton" Content="F9" Width="120" Click="SwapBindButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ PROFILES CARD ═══════ -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="PROFILES" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="ProfileCombo" SelectionChanged="ProfileCombo_SelectionChanged" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="NewProfileNameInput" Width="120" Text="New Profile" Margin="0,0,6,0"/>
                                <Button x:Name="NewProfileBtn" Content="Add" Width="55" Click="NewProfileBtn_Click" Margin="0,0,4,0"/>
                                <Button x:Name="DelProfileBtn" Content="Del" Width="55" Click="DelProfileBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ SHARE CARD ═══════ -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="SHARE" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="ExportBtn" Content="Copy Code" Width="120" Click="ExportBtn_Click" 
                                        Style="{StaticResource AccentButton}" Margin="0,0,6,0"/>
                                <Button x:Name="ImportBtn" Content="Paste Code" Width="120" Click="ImportBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
